# App Configuration
VITE_APP_NAME=Trackwyze
VITE_APP_URL=https://trackwyze.app

# Supabase Configuration
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Error monitoring (optional — omit to run without Sentry). This DSN is
# meant to be public/client-bundled, unlike server secrets.
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Product analytics (optional — omit to run without PostHog). Also a
# public, client-bundled key by design.
VITE_POSTHOG_KEY=phc_example
VITE_POSTHOG_HOST=https://us.i.posthog.com

# SendGrid, Anthropic, and Flutterwave keys are server-side secrets, not
# client config — they live only in Supabase Edge Function secrets
# (see supabase/functions/README.md), never here, never VITE_-prefixed.
